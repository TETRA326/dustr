{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dustr",
  "mainBinaryName": "Dustr",
  "version": "0.2.0",
  "identifier": "io.github.dustr",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dustr",
        "width": 920,
        "height": 780,
        "minWidth": 640,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "Dustr contributors",
    "license": "GPL-3.0-only",
    "shortDescription": "Swipe through a folder to clean it out",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
